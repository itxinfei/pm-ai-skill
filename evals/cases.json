{
  "version": "1.1",
  "description": "行为回归用例。每条描述一个输入和期望的行为特征。checks 是人工判据，auto 是可机检规则；auto 覆盖不到的仍要人看。",
  "how_to_run": "自动评分：pm-ai-skill score <case-id> <输出文件> 或 pm-ai-skill score all <目录>。人工回归见 evals/README.md。",
  "rule_types": {
    "has": "必须出现的字符串",
    "hasAny": "至少出现其中一个",
    "not": "不得匹配的正则",
    "first": "首段（第一个空行前）必须含其中一个",
    "maxChars": "全文字符数上限",
    "minChars": "全文字符数下限",
    "maxCount": "正则匹配次数上限"
  },
  "cases": [
    {
      "id": "route-001",
      "category": "分诊路由",
      "input": "这个需求我们到底该不该做？",
      "expected": "识别为判断类，先给结论和依据，不直接开始写文档",
      "checks": [
        "第一段出现明确结论",
        "给出判断依据而非框架罗列",
        "不产出 PRD 结构"
      ],
      "auto": [
        { "t": "first", "v": ["不该", "不建议", "不值得", "可以做", "该做", "先别"], "label": "第一段出现明确结论" },
        { "t": "hasAny", "v": ["因为", "原因", "依据", "判断", "关键是", "理由"], "label": "给出判断依据" },
        { "t": "not", "v": "^##\\s+[一二三四五六七八九十]", "label": "不产出 PRD 章节结构" }
      ]
    },
    {
      "id": "route-002",
      "category": "分诊路由",
      "input": "帮我写个会员体系的 PRD",
      "expected": "识别为产出类，问清背景和目标后再动笔",
      "checks": [
        "先问业务背景或目标用户",
        "不直接输出空模板",
        "不追问超过 4 个问题"
      ],
      "auto": [
        { "t": "hasAny", "v": ["背景", "目标用户", "业务场景", "给谁用"], "label": "先问业务背景或目标用户" },
        { "t": "not", "v": "^##\\s+一、", "label": "不直接输出空模板" },
        { "t": "maxCount", "v": "？|\\?", "n": 4, "label": "追问不超过 4 个问题" }
      ]
    },
    {
      "id": "route-003",
      "category": "分诊路由",
      "input": "帮我把这个想法从头推到能开发",
      "expected": "识别为链路类，先报价步骤和交接物，让用户能砍步骤",
      "checks": [
        "列出步骤和每步产出物",
        "明确需要用户确认的点",
        "不超过一条主链路"
      ],
      "auto": [
        { "t": "hasAny", "v": ["步骤", "第一步", "第一步", "1."], "label": "列出步骤" },
        { "t": "hasAny", "v": ["产出", "交付", "交接"], "label": "标出每步产出物" },
        { "t": "hasAny", "v": ["确认", "拍板", "定一下"], "label": "写明要用户确认的点" }
      ]
    },
    {
      "id": "route-004",
      "category": "分诊路由",
      "input": "帮我算一下这个功能能带来多少收入",
      "expected": "识别为覆盖不到的范围（商业化测算），直说边界并给可做的部分",
      "checks": [
        "明确说明不做收入预测",
        "给出替代做法如拆解口径",
        "不编造具体数字"
      ],
      "auto": [
        { "t": "hasAny", "v": ["不做收入", "不预测", "算不出", "给不了", "不在我"], "label": "说明不做收入预测" },
        { "t": "hasAny", "v": ["口径", "拆解", "可以帮你", "能给你"], "label": "给替代做法" },
        { "t": "not", "v": "\\d+\\s*[亿万]元?\\s*(的)?收入", "label": "不编造收入数字" }
      ]
    },
    {
      "id": "chain-001",
      "category": "链路编排",
      "input": "写个 PRD，然后帮我看看有没有问题",
      "expected": "走 A 链路前半段，PRD 完成后直接进评审，用交接摘要衔接",
      "checks": [
        "PRD 输出含待确认项",
        "评审输入取自 PRD 而非重新提问",
        "交接摘要不超过 10 行"
      ],
      "auto": [
        { "t": "hasAny", "v": ["待确认", "待补", "需要确认"], "label": "PRD 含待确认项" },
        { "t": "hasAny", "v": ["评审", "阻断", "风险"], "label": "PRD 后接评审" },
        { "t": "not", "v": "(再|重新)(发|给)我.{0,8}(PRD|文档|材料)", "label": "不重复索取已给材料" }
      ]
    },
    {
      "id": "chain-002",
      "category": "链路编排",
      "input": "先做需求排序，再出个季度路线图",
      "expected": "走 B 链路，排序结果作为路线图输入",
      "checks": [
        "排序说明用了哪个模型",
        "标出模型之间的分歧",
        "路线图引用排序结果"
      ],
      "auto": [
        { "t": "hasAny", "v": ["RICE", "MoSCoW", "ICE", "KANO", "优先级模型"], "label": "排序说明用了哪个模型" },
        { "t": "hasAny", "v": ["分歧", "不一样", "差异"], "label": "标出模型间分歧" },
        { "t": "hasAny", "v": ["路线图", "Roadmap", "季度"], "label": "产出路线图" }
      ]
    },
    {
      "id": "chain-003",
      "category": "链路编排",
      "input": "只帮我排个优先级就行",
      "expected": "只做一步，不强推后续链路",
      "checks": [
        "只输出排序",
        "不主动追加路线图或 PRD"
      ],
      "auto": [
        { "t": "hasAny", "v": ["P0", "P1", "优先级", "排序"], "label": "输出排序结果" },
        { "t": "not", "v": "(路线图|Roadmap|roadmap)", "label": "不追加路线图" },
        { "t": "not", "v": "^##\\s+一、", "label": "不追加 PRD" }
      ]
    },
    {
      "id": "review-001",
      "category": "多角色评审",
      "input": "帮我评审这份 PRD（附文档）",
      "expected": "六视角过一遍，按阻断/重要/建议分级，最后给一句结论",
      "checks": [
        "覆盖产品/研发/测试/设计/运营/法务",
        "问题分三级",
        "有明确结论句"
      ],
      "auto": [
        { "t": "has", "v": "研发", "label": "覆盖研发视角" },
        { "t": "has", "v": "测试", "label": "覆盖测试视角" },
        { "t": "hasAny", "v": ["法务", "合规"], "label": "覆盖法务视角" },
        { "t": "hasAny", "v": ["阻断", "重要", "建议"], "label": "问题分三级" },
        { "t": "hasAny", "v": ["结论", "能不能上", "建议上线", "不建议上线"], "label": "有明确结论句" }
      ]
    },
    {
      "id": "review-002",
      "category": "多角色评审",
      "input": "明天就上线了，再帮我看看这个方案",
      "expected": "自动切终审档，合规/回滚/验收标准任一问题升为阻断",
      "checks": [
        "识别上线压力并声明档位",
        "法务运营测试相关问题标为阻断",
        "给出能不能上的结论"
      ],
      "auto": [
        { "t": "hasAny", "v": ["终审", "按上线", "上线前"], "label": "识别上线压力并声明档位" },
        { "t": "has", "v": "阻断", "label": "有阻断级别" },
        { "t": "hasAny", "v": ["能上", "不能上", "可以上线", "不建议上线", "暂缓"], "label": "给出能不能上的结论" }
      ]
    },
    {
      "id": "review-003",
      "category": "多角色评审",
      "input": "帮我看看这个（只给一句话描述）",
      "expected": "材料太粗糙时先列缺口，不硬评",
      "checks": [
        "指出材料不足以评审",
        "列出需要补充的信息",
        "不输出泛泛的评审意见"
      ],
      "auto": [
        { "t": "hasAny", "v": ["信息不够", "材料不足", "不足以", "太粗", "没法评"], "label": "指出材料不足" },
        { "t": "hasAny", "v": ["需要你补", "补充", "给我这些", "至少要知道"], "label": "列出要补的信息" },
        { "t": "not", "v": "^(?!.*(不足|不够|没法)).*##\\s+(产品|研发)", "label": "不硬出评审意见" }
      ]
    },
    {
      "id": "review-004",
      "category": "多角色评审",
      "input": "评审这个方案（完整 PRD）",
      "expected": "指出角色间的分歧，而不是抹平成统一建议",
      "checks": [
        "单独列出分歧点",
        "写明各方立场",
        "给出一句如何处理的建议"
      ],
      "auto": [
        { "t": "hasAny", "v": ["分歧", "不一致", "冲突", "各有"], "label": "单独列出分歧点" },
        { "t": "hasAny", "v": ["立场", "认为", "主张"], "label": "写明各方立场" },
        { "t": "hasAny", "v": ["建议", "处理", "折中", "先按"], "label": "给出处理建议" }
      ]
    },
    {
      "id": "checkup-001",
      "category": "需求体检",
      "input": "老板说要做这个功能，帮我写 PRD",
      "expected": "识别需求来源只有老板说，提示风险但不阻拦",
      "checks": [
        "指出缺少用户证据",
        "给出验证建议",
        "用户坚持后照写并把风险写进待确认首条"
      ],
      "auto": [
        { "t": "hasAny", "v": ["没有用户证据", "缺少证据", "用户侧证据", "只有老板"], "label": "指出缺少用户证据" },
        { "t": "hasAny", "v": ["验证", "试点", "灰度", "小范围"], "label": "给出验证建议" },
        { "t": "hasAny", "v": ["待确认", "风险"], "label": "风险进待确认" }
      ]
    },
    {
      "id": "checkup-002",
      "category": "需求体检",
      "input": "帮我写个签到功能的 PRD",
      "expected": "追问用户现在怎么解决、成功看哪个指标",
      "checks": [
        "问到现有替代方案",
        "问到成功指标",
        "不预设答案"
      ],
      "auto": [
        { "t": "hasAny", "v": ["现在怎么", "目前怎么", "替代", "土办法"], "label": "问到现有替代方案" },
        { "t": "hasAny", "v": ["指标", "衡量", "成功怎么", "看哪个数"], "label": "问到成功指标" },
        { "t": "not", "v": "^(?!.*(？|\\?)).*##\\s+一、", "label": "没追问就直接动笔" }
      ]
    },
    {
      "id": "boundary-001",
      "category": "边界与诚实",
      "input": "这个市场大概多大？给我个准确数字",
      "expected": "给推算方式和区间，标注假设，不编精确数字",
      "checks": [
        "给区间不给单点",
        "标注假设和置信度",
        "提示需人工核验"
      ],
      "auto": [
        { "t": "hasAny", "v": ["区间", "到", "量级", "大概范围"], "label": "给区间不给单点" },
        { "t": "hasAny", "v": ["假设", "前提", "置信"], "label": "标注假设" },
        { "t": "hasAny", "v": ["核验", "核实", "查证", "自己确认"], "label": "提示需人工核验" }
      ]
    },
    {
      "id": "boundary-002",
      "category": "边界与诚实",
      "input": "你保证这个方案能提升 30% 转化吗？",
      "expected": "拒绝承诺具体效果，说明能做什么",
      "checks": [
        "不承诺数字",
        "说明可给的是风险清单和验证方案",
        "不推诿敷衍"
      ],
      "auto": [
        { "t": "hasAny", "v": ["不承诺", "不能保证", "无法保证", "不敢保证", "保证不了"], "label": "拒绝承诺具体效果" },
        { "t": "hasAny", "v": ["风险", "验证", "实验", "小流量"], "label": "说明能给的是风险清单和验证方案" },
        { "t": "not", "v": "^(?!.*(不能|无法|不敢|保证不了)).*(一定|肯定|必然)能.{0,10}(提升|提高)", "label": "不给效果承诺" }
      ]
    },
    {
      "id": "boundary-003",
      "category": "边界与诚实",
      "input": "帮我设计一个中国式的股权激励方案",
      "expected": "直说不在覆盖范围，不硬套产品框架",
      "checks": [
        "明确说明超出范围",
        "不编造法律条款",
        "可建议找专业顾问"
      ],
      "auto": [
        { "t": "hasAny", "v": ["不在", "超出", "范围外", "不覆盖", "不擅长"], "label": "说明超出范围" },
        { "t": "hasAny", "v": ["律师", "顾问", "专业机构", "财税"], "label": "建议找专业顾问" },
        { "t": "not", "v": "第\\s*\\d+\\s*条.{0,20}(股权|激励)", "label": "不编造法律条款" }
      ]
    },
    {
      "id": "style-001",
      "category": "表达",
      "input": "帮我写个周报",
      "expected": "说人话，不堆赋能/闭环/抓手，结论在前",
      "checks": [
        "不含赋能/闭环/抓手/生态位等词",
        "结论或关键进展在前两段",
        "有具体事项而非空泛总结"
      ],
      "auto": [
        { "t": "not", "v": "(赋能|闭环|抓手|生态位|组合拳|颗粒度|底层逻辑)", "label": "不含套话词" },
        { "t": "first", "v": ["完成", "进展", "结论", "本周", "卡在"], "label": "结论或进展在前" },
        { "t": "hasAny", "v": ["周一", "周二", "周三", "周四", "周五", "%", "个", "上线", "评审"], "label": "有具体事项" }
      ]
    },
    {
      "id": "style-002",
      "category": "表达",
      "input": "把这段话改得像人写的",
      "expected": "改表达不改事实，保留信息",
      "checks": [
        "事实与数字不变",
        "去掉模板化句式",
        "不编造细节"
      ],
      "auto": [
        { "t": "not", "v": "(赋能|闭环|抓手|生态位)", "label": "去掉套话" },
        { "t": "maxChars", "n": 800, "label": "没有大段扩写" },
        { "t": "minChars", "n": 30, "label": "有实际内容" }
      ]
    },
    {
      "id": "data-001",
      "category": "数据与度量",
      "input": "我们 DAU 跌了 15%，帮我分析一下",
      "expected": "先拆维度提假设，再给验证方法，不直接下结论",
      "checks": [
        "列出拆分维度",
        "给出多个可能原因",
        "说明怎么验证"
      ],
      "auto": [
        { "t": "hasAny", "v": ["维度", "分层", "拆分", "渠道", "人群", "版本"], "label": "列出拆分维度" },
        { "t": "hasAny", "v": ["可能", "假设", "原因之一", "要么"], "label": "给出多个可能原因" },
        { "t": "hasAny", "v": ["验证", "排查", "对照", "看下"], "label": "说明怎么验证" }
      ]
    },
    {
      "id": "data-002",
      "category": "数据与度量",
      "input": "设计一个 AB 实验验证新首页",
      "expected": "给假设、分流、样本量、判定标准、止损条件",
      "checks": [
        "有明确假设",
        "有样本量估算方式",
        "判定标准在实验前定义",
        "有止损条件"
      ],
      "auto": [
        { "t": "has", "v": "假设", "label": "有明确假设" },
        { "t": "hasAny", "v": ["样本量", "样本"], "label": "有样本量估算" },
        { "t": "hasAny", "v": ["判定", "显著性", "置信"], "label": "判定标准前置" },
        { "t": "hasAny", "v": ["止损", "停止", "熔断", "叫停"], "label": "有止损条件" }
      ]
    },
    {
      "id": "research-001",
      "category": "用户调研",
      "input": "帮我写个用户访谈提纲，问问他们喜不喜欢我们的新功能",
      "expected": "纠正诱导性问法，改成问过去行为",
      "checks": [
        "指出'喜不喜欢'是诱导性问题",
        "改成问上次怎么做的",
        "不预设立场"
      ],
      "auto": [
        { "t": "hasAny", "v": ["诱导", "倾向", "不中立", "暗示"], "label": "指出诱导性问题" },
        { "t": "hasAny", "v": ["上次", "过去", "最近一次", "实际行为"], "label": "改成问过去行为" },
        { "t": "not", "v": "你(是不是|是否)(觉得|喜欢)", "label": "不预设立场" }
      ]
    },
    {
      "id": "competitor-001",
      "category": "竞品与市场",
      "input": "分析一下这个竞品我们能抄什么",
      "expected": "四维拆解后给可抄/不可抄/差异化，不笼统说抄",
      "checks": [
        "拆分维度和结论对应",
        "区分表面功能和底层能力",
        "给出差异化建议"
      ],
      "auto": [
        { "t": "hasAny", "v": ["维度", "拆解", "四个", "四维"], "label": "按维度拆解" },
        { "t": "hasAny", "v": ["表面", "底层", "能力"], "label": "区分表面与底层" },
        { "t": "hasAny", "v": ["差异化", "不可抄", "不能抄", "抄不了"], "label": "给差异化建议" }
      ]
    },
    {
      "id": "self-001",
      "category": "自我迭代",
      "input": "我这两个月做的项目帮我复盘一下，我想知道自己哪里不行",
      "expected": "给具体可改的行为，不给空泛评价",
      "checks": [
        "指出具体决策问题",
        "给出下次的具体改法",
        "不堆人格化标签"
      ],
      "auto": [
        { "t": "hasAny", "v": ["决策", "判断", "排期", "范围", "沟通"], "label": "指出具体决策问题" },
        { "t": "hasAny", "v": ["下次", "以后", "改成", "做法"], "label": "给出下次的具体改法" },
        { "t": "not", "v": "(性格|人格|天生|你这个人)", "label": "不堆人格化标签" }
      ]
    },
    {
      "id": "material-001",
      "category": "带材料分诊",
      "input": "（贴三段访谈记录，共 200 字）这几段你帮我看看，能提炼出什么",
      "expected": "先复述从材料里看到的要点，再抽原声、做聚类，同时标注样本量不足",
      "checks": [
        "开口先说看到了什么，不反问用户想做什么",
        "原声摘录而不是概括成空话",
        "指出样本量或覆盖范围的局限"
      ],
      "auto": [
        { "t": "hasAny", "v": ["我看到", "材料里", "从这几段", "这三段"], "label": "先说看到什么" },
